# Copy to ansible/inventory.ini after terraform apply, or use the file
# auto-generated by Terraform (see terraform/main.tf local_file.ansible_inventory).
#
# Groups: [web] = public bastion + nginx; [streamer] = private FFmpeg host.

[web]
54.144.203.113 ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/id_ed25519

[web:vars]
stream_domain=teambkn.devops.intuitivelabs.net
certbot_email=devops@example.com
web_enable_https=true

[streamer]
172.16.2.113 ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/id_ed25519

[streamer:vars]
ansible_ssh_common_args=-o ProxyJump=ubuntu@54.144.203.113
web_frontend_private_ip=172.16.1.9
sample_video_url=https://download.blender.org/peach/bigbuckbunny_movies/BigBuckBunny_320x180.mp4
rtmp_application=live
rtmp_stream_name=stream
